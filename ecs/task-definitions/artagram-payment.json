{
  "family": "artagram-payment",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/artagramEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/artagramEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "artagram-payment",
      "image": "${IMAGE_URI}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8089,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8089"
        },
        {
          "name": "DB_HOST",
          "value": "${DB_HOST}"
        },
        {
          "name": "DB_PORT",
          "value": "${DB_PORT}"
        },
        {
          "name": "DB_USER",
          "value": "${DB_USER}"
        },
        {
          "name": "DB_PASSWORD",
          "value": "${DB_PASSWORD}"
        },
        {
          "name": "DB_NAME",
          "value": "db_payment"
        },
        {
          "name": "RABBITMQ_HOST",
          "value": "${RABBITMQ_HOST}"
        },
        {
          "name": "RABBITMQ_PORT",
          "value": "${RABBITMQ_PORT}"
        },
        {
          "name": "RABBITMQ_USER",
          "value": "${RABBITMQ_USER}"
        },
        {
          "name": "RABBITMQ_PASSWORD",
          "value": "${RABBITMQ_PASSWORD}"
        },
        {
          "name": "RABBITMQ_EXCHANGE",
          "value": "artagram.events"
        },
        {
          "name": "JWT_PUBLIC_KEY_PEM",
          "value": "${JWT_PUBLIC_KEY_PEM}"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "${CORS_ORIGINS}"
        },
        {
          "name": "PAGO_PROVEEDOR",
          "value": "${PAGO_PROVEEDOR}"
        },
        {
          "name": "MP_ACCESS_TOKEN",
          "value": "${MP_ACCESS_TOKEN}"
        },
        {
          "name": "MERCADOPAGO_WEBHOOK_SECRET",
          "value": "${MERCADOPAGO_WEBHOOK_SECRET}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/artagram-payment",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
