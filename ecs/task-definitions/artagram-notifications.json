{
  "family": "artagram-notifications",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/artagramEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/artagramEcsTaskRole",
  "containerDefinitions": [
    {
      "name": "artagram-notifications",
      "image": "${IMAGE_URI}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8090,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8090"
        },
        {
          "name": "SPRING_DATA_MONGODB_URI",
          "value": "${NOTIFICATIONS_MONGODB_URI}"
        },
        {
          "name": "RABBITMQ_HOST",
          "value": "rabbitmq.artagram.local"
        },
        {
          "name": "RABBITMQ_PORT",
          "value": "5672"
        },
        {
          "name": "RABBITMQ_USER",
          "value": "${NOTIFICATIONS_RABBITMQ_USER}"
        },
        {
          "name": "RABBITMQ_PASSWORD",
          "value": "${NOTIFICATIONS_RABBITMQ_PASSWORD}"
        },
        {
          "name": "RABBITMQ_VHOST",
          "value": "notifications"
        },
        {
          "name": "JWT_PUBLIC_KEY_PEM",
          "value": "${JWT_PUBLIC_KEY_PEM}"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "${CORS_ORIGINS}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/artagram-notifications",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
