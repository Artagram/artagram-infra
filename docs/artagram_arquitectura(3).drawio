              <mxPoint x="2197" y="1223.1666259765625" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="CXDY4G5tNKBJfa2Zyyy2-269" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=open;startFill=0;endArrow=open;endFill=0;strokeColor=#666666;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="AMQP 0-9-1 (TCP :5672)">
          <mxGeometry relative="1" x="0.5912" y="19" as="geometry">
            <mxPoint x="-6" y="-13" as="offset" />
            <Array as="points">
              <mxPoint x="2586.67" y="1223.17" />
            </Array>
            <mxPoint x="2519.9999037366783" y="1173.1666259765623" as="sourcePoint" />
            <mxPoint x="2586.67" y="1253.1666259765623" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CXDY4G5tNKBJfa2Zyyy2-271" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#666666;" value="&lt;b&gt;Protocolos&lt;/b&gt;&lt;br&gt;REST/HTTP: HTTP/1.1–2 sobre TCP, JSON&lt;br&gt;WebSocket (línea gruesa morada): solo Lienzo y salas, TCP, upgrade desde HTTP&lt;br&gt;SSE: HTTP streaming sobre TCP, servidor→cliente (chat y alertas)&lt;br&gt;AMQP 0-9-1: TCP :5672 (RabbitMQ)&lt;br&gt;JDBC :5432 · Redis RESP :6379 · MongoDB :27017 (todos TCP)&lt;br&gt;Línea sólida = síncrono · punteada = asíncrono vía broker&lt;br&gt;Bola+socket = servicio ↔ su almacenamiento" vertex="1">
          <mxGeometry height="170" width="420" x="2917" y="253.1666259765625" as="geometry" />
        </mxCell>
        <mxCell id="CXDY4G5tNKBJfa2Zyyy2-272" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#666666;" value="&lt;b&gt;Eventos en RabbitMQ&lt;/b&gt;&lt;br&gt;Feed → &lt;i&gt;post.published&lt;/i&gt; → Worker de media&lt;br&gt;Worker de media → &lt;i&gt;media.processed&lt;/i&gt; → Feed (BlurHash, estado)&lt;br&gt;Feed → &lt;i&gt;ai.analyze&lt;/i&gt; → Worker de IA&lt;br&gt;Worker de IA → &lt;i&gt;ai.completed&lt;/i&gt; → Feed y Chat/Notif.&lt;br&gt;Usuarios → &lt;i&gt;follow.created&lt;/i&gt;, &lt;i&gt;subscription.updated&lt;/i&gt; → Chat/Notif.&lt;br&gt;Autenticación → &lt;i&gt;user.registered&lt;/i&gt;, &lt;i&gt;user.deleted&lt;/i&gt; → Usuarios (crea / borra el perfil)&lt;br&gt;Feed → &lt;i&gt;like.created&lt;/i&gt; → Chat/Notif.&lt;br&gt;Lienzo → &lt;i&gt;canvas.closed&lt;/i&gt; → Feed (publica la obra)&lt;br&gt;Lienzo → &lt;i&gt;room.message&lt;/i&gt; → Chat/Notif. (guarda el chat de sala)" vertex="1">
          <mxGeometry height="230" width="420" x="2917" y="443.1666259765625" as="geometry" />
        </mxCell>
        <mxCell id="CXDY4G5tNKBJfa2Zyyy2-273" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#666666;" value="&lt;b&gt;Decisiones clave&lt;/b&gt;&lt;br&gt;• Una sola instancia PostgreSQL, Redis y MongoDB; bases separadas por servicio (nadie lee la BD de otro).&lt;br&gt;• Lienzo: servidor autoritativo con WebSocket; Redis pub/sub reparte los trazos entre instancias. Sin WebRTC ni host P2P.&lt;br&gt;• Al cerrar la sala, el cliente host exporta la imagen y la sube a Blob/S3 con URL prefirmada; si falla, el servidor la renderiza desde los trazos en Redis.&lt;br&gt;• Chat de sala: viaja por el WebSocket del Lienzo; Lienzo publica &lt;i&gt;room.message&lt;/i&gt; y Chat lo guarda en MongoDB (db_chat), así cada servicio escribe solo en su BD.&lt;br&gt;• JWT lo emite Usuarios y lo valida el Gateway.&lt;br&gt;• Los webhooks de pago son idempotentes (se guarda el ID del evento).&lt;br&gt;• Despliegue: Docker Compose en local, Azure Container Apps en la nube.&lt;br&gt;• Autenticación: servicio propio que emite el JWT; el Gateway lo valida con la clave pública (JWKS, HTTP). Usuarios crea el perfil al recibir &lt;i&gt;user.registered&lt;/i&gt;, con el mismo userId (&lt;i&gt;sub&lt;/i&gt; del token).&lt;br&gt;• Pagos: Usuarios llama a Mercado Pago por API; el webhook entra por el Gateway, se valida por firma (sin JWT) y es idempotente.&lt;br&gt;• SSE sin broker nuevo: Chat ya consume de RabbitMQ y empuja por SSE. Con varias instancias, cada una crea una cola exclusiva en el exchange.&lt;br&gt;• Sin CDN ni Kafka por ahora; se agregan si las métricas lo piden.&lt;br&gt;• Object storage: Blob (Azure) o S3 (AWS), mismo patrón de URL prefirmada." vertex="1">
          <mxGeometry height="470" width="420" x="2917" y="693.1666259765625" as="geometry" />
        </mxCell>
        <mxCell id="CXDY4G5tNKBJfa2Zyyy2-278" edge="1" parent="1" source="CXDY4G5tNKBJfa2Zyyy2-191" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0;entryDx=0;entryDy=142.5;entryPerimeter=0;dashed=1;strokeColor=light-dark(#000000,#808080);" target="CXDY4G5tNKBJfa2Zyyy2-228">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1777" y="870" />
              <mxPoint x="2299.48" y="870" />
            </Array>
          </mxGeometry>
        </mxCell>
