        <mxCell id="CXDY4G5tNKBJfa2Zyyy2-268" edge="1" parent="1" source="CXDY4G5tNKBJfa2Zyyy2-228" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;startArrow=open;startFill=0;endArrow=open;endFill=0;strokeColor=#666666;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="CXDY4G5tNKBJfa2Zyyy2-230" value="AMQP 0-9-1 (TCP :5672)">
