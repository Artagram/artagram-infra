# ==============================================================================
# ArtaGram Infraestructura Local (.env.example)
# Copiar a .env para personalizar puertos o credenciales locales
# ==============================================================================

# --- Puertos de Infraestructura ---
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Puertos de Microservicios ---
GATEWAY_PORT=8080
AUTH_PORT=8081
USERS_PORT=8082
FEED_PORT=8083
LIENZO_PORT=8084
CHAT_PORT=8085
MEDIA_WORKER_PORT=8086
AI_WORKER_PORT=8087

# --- Credenciales Locales ---
POSTGRES_DB=artagram
POSTGRES_USER=artagram
POSTGRES_PASSWORD=artagram

MONGO_USER=artagram
MONGO_PASSWORD=artagram

RABBITMQ_USER=artagram
RABBITMQ_PASSWORD=artagram

MINIO_ROOT_USER=artagram
MINIO_ROOT_PASSWORD=artagram123
S3_BUCKET=artagram-uploads
STORAGE_PROVIDER=s3

# --- Seguridad y URLs ---
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
APP_API_BASE_URL=http://localhost:8080
GATEWAY_JWT_ENABLED=false
JWT_SECRET=secreto-desarrollo-minimo-32-bytes-longitud-segura-artagram
MEDIA_SIGNING_SECRET=secreto-firma-media-desarrollo-32-bytes

# --- Correo y Seeding ---
EMAIL_MODE=log
VERIFICACION_CORREO=false
SPRING_PROFILES_ACTIVE=seed

# --- Inteligencia Artificial (Groq / Fake) ---
LLM_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODELO=qwen/qwen3.8-27b

# --- Proveedor de Pagos (Mercado Pago / Fake) ---
PAYMENT_PROVIDER=fake
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
