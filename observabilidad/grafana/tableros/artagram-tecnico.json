    {
      "type": "row",
      "title": "JVM",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 58
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Heap usado por servicio",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 59
      },
      "fieldConfig": {
