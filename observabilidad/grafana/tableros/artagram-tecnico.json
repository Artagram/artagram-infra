          },
          "refId": "A",
          "expr": "sum(increase(gateway_origenes_bloqueados_total[15m]))",
          "legendFormat": "bloqueados"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Respuestas 429 del gateway",
      "id": 19,
      "datasource": {
